;
; MBRFilterPP.inf
;

[Version]
Signature   = "$Windows NT$"
Class       = DiskDrive
ClassGUID   = {4d36e967-e325-11ce-bfc1-08002be10318}
Provider    = %Author%
DriverVer   = 04/25/2026,1.0.0.1
CatalogFile = MBRFilterPP.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12 ; %SystemRoot%\system32\drivers

[SourceDisksNames]
1 = %diskid1%,,,

[SourceDisksFiles]
MBRFilterPP.sys = 1

; ================= Installation =================

; The .ntamd64 decoration satisfies the "Architecture Decoration" requirement
[DefaultInstall.NTamd64]
CopyFiles = MBRFilterPP.CopyFiles
AddReg    = MBRFilterPP.AddReg

[MBRFilterPP.CopyFiles]
MBRFilterPP.sys

[MBRFilterPP.AddReg]
; 0x00010008 = FLG_ADDREG_TYPE_MULTI_SZ | FLG_ADDREG_APPEND
HKLM, System\CurrentControlSet\Control\Class\{4d36e967-e325-11ce-bfc1-08002be10318}, UpperFilters, 0x00010008, MBRFilterPP

; ================= Service =================

[DefaultInstall.NTamd64.Services]
AddService = MBRFilterPP, , MBRFilterPP.Service.Install

[MBRFilterPP.Service.Install]
DisplayName    = %service_desc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 0               ; SERVICE_BOOT_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\MBRFilterPP.sys
LoadOrderGroup = "PnP Filter"

; ================= Strings =================

[Strings]
Author       = "Community Open Source"
service_desc = "MBRFilter++ Integrity Guard"
diskid1      = "MBRFilter++ Installation Disk"